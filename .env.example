# ================= subtitle-forge 环境变量模板 =================
# 复制为 .env 后按需修改：cp .env.example .env
# 所有项均可在 Web 设置页覆盖（写入 SQLite），环境变量仅作首次默认值

# ---------- Web ----------
WEB_PORT=8310
TZ=Asia/Shanghai

# 运行模式：manual=手动 / scheduled=定时 / guard=智能监控
MODE=manual
QUEUE_PAUSED=false
SCAN_INTERVAL_MINUTES=60

# 监控目录（容器内路径，逗号分隔）
WATCH_DIRS=/Media

# ---------- ASR ----------
# local=容器内 faster-whisper / llama=llama-swap 托管 whisper.cpp
ASR_PROVIDER=local
ASR_MODEL=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=auto
ASR_CPU_THREADS=8

# ---------- 翻译模型（OpenAI 兼容接口）----------
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.3

# ---------- 质检模型（留空回退翻译模型）----------
REVIEW_BASE_URL=
REVIEW_API_KEY=
REVIEW_MODEL=
REVIEW_SAMPLE_COUNT=12

# ---------- 润色模型（留空依次回退质检模型 → 翻译模型）----------
POLISH_ENABLED=false
POLISH_BASE_URL=
POLISH_API_KEY=
POLISH_MODEL=
POLISH_TEMPERATURE=0.3

# ---------- 流水线 ----------
PHASE_MODE=pipeline
SOURCE_LANG=auto
TARGET_LANG=zh
SUBTITLE_SUFFIX=.zh
TRANSLATE_ONLY=false
SKIP_EXISTING_SUBTITLE=true
TRANSCRIPT_QUALITY_THRESHOLD=60
TRANSLATION_QUALITY_THRESHOLD=70

# ---------- 同批次限流 ----------
# 同批次任务数量上限（1-100）：当前批次全部结束（含失败）后才放行下一批
BATCH_SIZE=20

# ---------- LLM 调用健壮性 ----------
# 单次请求超时（秒）/ 重试次数 / 单次调用总时间预算（秒）
LLM_TIMEOUT=180
LLM_MAX_ATTEMPTS=3
LLM_TOTAL_BUDGET=360

# ---------- 增强转录（失败任务用更强模型重跑）----------
# 增强流程产出的字幕不再判失败，直接落视频原目录
ENHANCED_TRANSCRIBE_ENABLED=true
ENHANCED_ASR_MODEL=large-v3
# 留空沿用 ASR_COMPUTE_TYPE
ENHANCED_ASR_COMPUTE_TYPE=

# ---------- 并发 ----------
TASK_WORKERS=1
MAX_WORKERS=1
SMART_QUEUE=true
MULTI_MODEL_VRAM_MB=16000

# ---------- llama-swap 集成（可选，无需可全部留空）----------
# 宿主模型目录，映射到容器 /models-llama
LLAMA_MODELS_HOST=
LLAMA_SWAP_CONFIG=/config-llama.yaml
LLAMA_MODELS_DIR=/models-llama
LLAMA_SWAP_CONTAINER=llama-swap
SAKURA_CONTAINER=llama-sakura

# ---------- 其它 ----------
HF_ENDPOINT=https://hf-mirror.com
VIDEO_EXTS=.mp4,.mkv,.avi,.mov,.wmv,.flv,.webm,.ts,.m2ts
