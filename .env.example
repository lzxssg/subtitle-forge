# ================= subtitle-forge 环境变量模板 =================
# 复制为 .env 后按需修改：cp .env.example .env

# Web 端口
WEB_PORT=8310

# 运行模式：manual=手动 / scheduled=定时 / guard=智能监控
MODE=manual
QUEUE_PAUSED=false

# 监控目录（容器内路径，逗号分隔）
WATCH_DIRS=/media/library,/media/library,/media/library,/media/collection,/media/misc

# ---------- ASR ----------
ASR_MODEL=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=auto
# ASR 运行方式：local=容器内 faster-whisper / llama=llama-swap 托管
ASR_PROVIDER=llama

# ---------- 模型/管理器目录映射（重要）----------
# 部署容器前先在这里指定宿主目录，容器启动后即完成映射；
# 「一键部署」会按映射路径把 ggml 模型写入对应管理器。
LLAMA_MODELS_HOST=/mnt/llama/models

# ---------- LLM（OpenAI 兼容 / llama-swap）----------
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=sakura-gpu
REVIEW_BASE_URL=http://host.docker.internal:11434/v1
REVIEW_MODEL=qwen3_8b

# ---------- 流水线 ----------
PHASE_MODE=pipeline
SOURCE_LANG=auto
TARGET_LANG=zh
TRANSLATE_ONLY=false
SKIP_EXISTING_SUBTITLE=true
